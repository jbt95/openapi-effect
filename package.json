{
  "name": "openapi-effect",
  "version": "2.1.0",
  "description": "Generate Effect Schema and Effect-based HTTP clients from OpenAPI 3.0/3.1 specs",
  "keywords": [
    "api",
    "client",
    "codegen",
    "effect",
    "http",
    "openapi",
    "rest",
    "schema",
    "swagger",
    "typescript"
  ],
  "license": "MIT",
  "author": "",
  "bin": {
    "openapi-effect": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "postbuild": "node -e \"const fs=require('fs'); const content=fs.readFileSync('dist/cli.js','utf8'); if(!content.startsWith('#!/usr/bin/env node')) { fs.writeFileSync('dist/cli.js', '#!/usr/bin/env node\\n' + content) }\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "effect": "4.0.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.23.0"
}
